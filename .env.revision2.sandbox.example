# Fail-closed runtime switches. Do not change these during the first verification phase.
META_RUNTIME_MODE=sandbox
META_WEBHOOK_MODE=log_only
HUB_DISPATCH_MODE=simulate

PORT=3000
PUBLIC_APP_ORIGIN=https://staging.example.invalid

# Use a separate non-production Supabase project for sandbox verification.
SUPABASE_URL=https://sandbox-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_sandbox_value
SUPABASE_SERVICE_ROLE_KEY=sb_secret_sandbox_value

# Meta Developer App sandbox/test assets only. Never put either live phone ID here.
META_APP_ID=000000000000000
META_APP_SECRET=replace_with_sandbox_app_secret
META_GRAPH_VERSION=v25.0
META_SANDBOX_WABA_ID=000000000000000
META_SANDBOX_PHONE_NUMBER_ID=000000000000000
META_SANDBOX_ACCESS_TOKEN=replace_with_meta_test_access_token
META_SANDBOX_ASSET_ACK=replace_after_verifying_test_assets

# Optional defense-in-depth denylist. If populated, a matching sandbox ID stops the process.
META_PROTECTED_WABA_IDS=
META_PROTECTED_PHONE_NUMBER_IDS=

# Deliberately unused while META_RUNTIME_MODE=sandbox; keep empty.
META_EMBEDDED_SIGNUP_CONFIG_ID_FRESH=
META_EMBEDDED_SIGNUP_CONFIG_ID_MIGRATION=
META_EMBEDDED_SIGNUP_CONFIG_ID_COEXISTENCE=

META_WEBHOOK_VERIFY_TOKEN=replace_with_random_webhook_verify_token
META_ONBOARDING_STATE_SECRET=replace_with_at_least_32_random_bytes
META_TOKEN_ENCRYPTION_KEY_B64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
META_TOKEN_KEY_VERSION=1

# Intentionally absent in sandbox. Production additionally requires the exact live activation acknowledgement.
# META_LIVE_ACTIVATION_ACK=

# The Edge Function signs a preview but cannot call GitHub in simulate mode.
HUB_WEBHOOK_SECRET=replace_with_random_edge_webhook_secret
HUB_DISPATCH_SIGNING_SECRET=replace_with_random_hmac_secret
